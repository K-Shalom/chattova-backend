{
  "name": "chattova-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Chattova backend API — Node.js + Express + Socket.IO",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/unit/*.test.js",
    "db:test:migrate": "node scripts/migrate-test-db.js",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=30000 tests/integration/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3"
  }
}
